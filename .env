# ============================================
# Memory System Configuration
# ============================================
# Use mem0 for semantic memory (requires OpenAI API key)
# Set to "true" to enable mem0, "false" to use JSON storage
USE_MEM0=true

# Fallback to JSON if mem0 fails (recommended: true)
MEM0_FALLBACK_TO_JSON=true

# mem0 search configuration (optional - defaults shown)
MEM0_SEARCH_LIMIT=10
MEM0_SIMILARITY_THRESHOLD=0.3

# Custom mem0 configuration (optional - JSON string)
# MEM0_CUSTOM_CONFIG={"embedder":{"config":{"model":"text-embedding-3-large"}}}
